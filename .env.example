# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_PATH: Optional custom SQLite file path (defaults to ./data/tech-oferta.db)
DATABASE_PATH="./data/tech-oferta.db"

# MELI_ACCESS_TOKEN: Optional Mercado Livre Developers API OAuth token for higher rate limits on product lookup
MELI_ACCESS_TOKEN=""

# ADMIN_USERNAME & ADMIN_PASSWORD: Optional initial admin credentials (if omitted, first-run setup UI creates the admin account)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
